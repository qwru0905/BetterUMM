## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][In][32]/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
Log/
Logs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use a Visual Studio version lower than 2015
# *.suo
# *.user
# *.sln.docstates

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esults/
[Bb]uild[Cc]ontent/

# NUnit
/*.VisualState.xml
TestResult.xml
nunit-agent.log

# JetBrains Rider
.idea/
*.sln.iml

# CodeRush personal settings
.cr/

# Python Tools for Visual Studio (PTVS)
__pycache__/
*.pyc

# OpenCover
OpenCover/

# AxoCover
.axoCover/

# MAP NuGet packages
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if the target file is needed in main/master branch
# !**/packages/build/ProjectName.targets

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image-cache files
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on separate drives
$RECYCLE.BIN/

# VS Code
.vscode/

# Project-specific overrides
BetterUMM/bin/
BetterUMM/obj/

.claude/
